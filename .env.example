# Copy this file to .env and fill it in. Never commit .env.
#
# Supabase: open your project, click "Connect", and copy a connection string.
#   - On your computer (npm start, db:migrate, db:seed): "Session pooler"
#   - On Vercel (project settings > Environment Variables): "Transaction pooler" (port 6543)
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=

# TLS for the database connection:
#   require  encrypted, certificate not checked (default)
#   verify   encrypted and checked; set DATABASE_SSL_CA_FILE to Supabase's CA certificate
#            (Project Settings > Database > SSL Configuration > Download certificate)
#   disable  only for a Postgres running on this computer
DATABASE_SSL=require
DATABASE_SSL_CA_FILE=

PORT=3000

# Optional, for `npm run check:sources` (and the scheduled GitHub Action):
# a direct link to an official file, if one becomes available. PMBI and NPPA
# currently offer downloads only through buttons on their websites, so these are
# normally left empty and new versions are downloaded by hand.
PMBI_LIST_URL=
NPPA_LIST_URL=
